---
const to = "/en/releases";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>Moved · ORDO</title>
    <script is:inline>
      window.location.replace("/en/releases");
    </script>
  </head>
  <body style="font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; padding:24px;">
    <p>This page has moved to: <a href={to}>/en/releases</a></p>
  </body>
</html>
