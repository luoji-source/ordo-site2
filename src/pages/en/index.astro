---
import Base from "@/layouts/Base.astro";
import { getLocalStore } from "../../lib/local-store";

const store = getLocalStore?.() ?? {};
const site = store.site ?? {};
const brand = (site.brand ?? "ORDO").toString();
---

<Base
  lang="en"
  title={`${brand} · Home`}
  description="ORDO builds instruments and software that keep key states verifiable — helping you resume work and decisions after interruption."
  keywords={["ORDO", "RESPECTA", "instruments", "hardware", "software", "re-entry", "verifiable facts"]}
>
  <!-- Brand Home: judgement-first. Minimal, one-screen message + direct paths to Shop / Software / Instruments. -->

  <section class="home-hero" aria-label="ORDO designs and manufactures physical and digital instruments">
    <div class="container hero-shell">
      <div class="hero-copy">
        <div class="eyebrow">{brand}</div>

        <h1 class="home-h1" aria-label="ORDO designs and manufactures physical and digital instruments">
          <span class="home-h1-line">ORDO designs and manufactures</span>
          <span class="home-h1-line">physical and digital instruments</span>
        </h1>

        <h2 class="home-lead">
          For returning to your position after interruption,<br />
          and continuing judgment and action.
        </h2>

        <p class="home-body">
          No reminders. No tracking. No decisions made for you.<br />
          Only checkable facts, kept on the instrument or in the workflow.
        </p>

        <div class="cta-row">
          <a class="btn primary" href="/en/shop">Shop</a>
          <a class="btn outline" href="/en/software">Software</a>
          <a class="btn ghost" href="/en/products">Learn the instruments</a>
        </div>
      </div>

      <div class="hero-media">
        <figure class="hero-figure">
          <img
            src="/images/home/slide-structure-960.png"
            width="960"
            height="720"
            alt="Instrument detail (structure and scale)"
            loading="eager"
            decoding="async"
          />
          <figcaption>Line Pointer · Hardware example</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
