---
import Base from "@/layouts/Base.astro";

const qp = Astro.url.searchParams;
const rawType = (qp.get("type") || qp.get("topic") || "").toLowerCase();
const typeWhitelist = ["sales", "software", "support", "procurement", "partnership", "media"]; 
const presetType = typeWhitelist.includes(rawType) ? rawType : "support";
---

<Base lang="en" title="Support · ORDO">
  <section class="page">
    <div class="container">
      <header class="hero">
        <h1 class="h1">Support</h1>
        <p class="lead">
          One clear message to start. We do not use automated sales replies. The information you submit is used only to respond to this request.
        </p>
      </header>

      <div class="grid">
        <main class="card formCard" aria-label="Contact form">
          <div class="cardHead">
            <div class="k">Message</div>
            <div class="mini">Sales inquiries, Re-Entry access & licensing, support, partnerships</div>
          </div>

          <form id="supportForm" class="form" autocomplete="on">
            <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />

            <div class="row">
              <div class="field">
                <label for="name">Name <span class="req">*</span></label>
                <input id="name" name="name" type="text" placeholder="Your name" required minlength="2" maxlength="40" />
              </div>
              <div class="field">
                <label for="email">Email <span class="req">*</span></label>
                <input id="email" name="email" type="email" placeholder="name@example.com" required maxlength="120" />
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="org">Organization</label>
                <input id="org" name="org" type="text" placeholder="Optional" maxlength="80" />
              </div>
              <div class="field">
                <label for="type">Topic <span class="req">*</span></label>
                <select id="type" name="type" required>
                  <option value="support" selected={presetType === "support"}>Support / After-sales</option>
                  <option value="software" selected={presetType === "software"}>Soft access / licensing</option>
                  <option value="sales" selected={presetType === "sales"}>Sales inquiry (hardware / software)</option>
                  <option value="procurement" selected={presetType === "procurement"}>Procurement / invoicing</option>
                  <option value="partnership" selected={presetType === "partnership"}>Partnership</option>
                  <option value="media" selected={presetType === "media"}>Media</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="subject">Subject <span class="req">*</span></label>
              <input id="subject" name="subject" type="text" placeholder="e.g., Re-Entry licensing" required minlength="4" maxlength="80" />
            </div>

            <div class="field">
              <label for="message">Message <span class="req">*</span></label>
              <textarea
                id="message"
                name="message"
                rows="7"
                required
                minlength="20"
                maxlength="2000"
                placeholder="Helpful details: what you need to verify, your current state, and what you want as the next step."
              ></textarea>
            </div>

            <label class="consent">
              <input id="consent" name="consent" type="checkbox" required />
              <span>I agree that ORDO may contact me to respond to this request (not for marketing blasts).</span>
            </label>

            <div class="actions">
              <button id="submitBtn" class="btn primary" type="submit">Send</button>
              <div id="status" class="status" role="status" aria-live="polite"></div>
            </div>

            <div class="replyTime" aria-hidden="true">We reply within 24–48 hours.</div>

            <div class="hint">
              Tip: for hardware, include your order or batch reference; for software, include the version (see <a class="inline" href="/en/releases">Releases</a>).
            </div>
          </form>
        </main>

        <aside class="side" aria-label="Quick links">
          <section class="card sideCard">
            <div class="cardHead">
              <div class="k">Quick links</div>
              <div class="mini">Keep the conversation verifiable</div>
            </div>

            <div class="links">
              <a class="linkRow" href="/en/shop">
                <span class="t">Hardware store</span>
                <span class="s">Ordering and delivery</span>
              </a>
              <a class="linkRow" href="/en/software">
                <span class="t">Soft</span>
                <span class="s">Access / licensing / boundaries</span>
              </a>
              <a class="linkRow" href="/en/releases">
                <span class="t">Releases</span>
                <span class="s">Verifiable changes only</span>
              </a>
              <a class="linkRow" href="/en/manufacturing">
                <span class="t">Manufacturing</span>
                <span class="s">Hardware verification</span>
              </a>
            </div>

            <div class="small">
              We prioritize issues that impact safety, data integrity, delivery, or judgment accuracy.
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('supportForm');
    const status = document.getElementById('status');
    const btn = document.getElementById('submitBtn');
    const website = document.getElementById('website');
    website.style.position = 'absolute';
    website.style.left = '-9999px';
    website.style.opacity = '0';

    function setStatus(text, ok) {
      status.textContent = text;
      status.dataset.ok = ok ? '1' : '0';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('Sending…', true);
      btn.disabled = true;

      const fd = new FormData(form);
      const payload = {
        locale: 'en',
        source: 'website',
        ts: Date.now(),
        website: String(fd.get('website') || ''),
        type: String(fd.get('type') || 'support'),
        name: String(fd.get('name') || ''),
        email: String(fd.get('email') || ''),
        organization: String(fd.get('org') || ''),
        subject: String(fd.get('subject') || ''),
        message: String(fd.get('message') || ''),
        consent: Boolean(fd.get('consent')),
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json?.ok === false) {
          const msg = json?.error || 'Failed to send. Please try again.';
          setStatus(msg, false);
          btn.disabled = false;
          return;
        }

        const rid = json?.requestId ? ` (ID: ${json.requestId})` : '';
        setStatus('Sent. We will reply by email.' + rid, true);
        form.reset();
      } catch (err) {
        setStatus('Network error. Please try again.', false);
      } finally {
        btn.disabled = false;
      }
    });
  </script>

  <style>
    .page{ padding: 18px 0 44px; }
    .container{ max-width: 1120px; margin: 0 auto; padding: 0 18px; }
    .hero{ padding-top: 10px; }
    .h1{ margin: 8px 0 0; font-size: 44px; line-height: 1.08; letter-spacing: -0.02em; }
    .lead{ margin: 12px 0 0; color: rgba(220,235,240,.72); line-height: 1.75; max-width: 92ch; }

    .grid{ margin-top: 16px; display:grid; grid-template-columns: 1.2fr 0.8fr; gap: 12px; align-items: start; }

    .card{
      border-radius: 22px;
      border: 1px solid rgba(220,235,240,0.12);
      background: radial-gradient(120% 120% at 20% 0%, rgba(48,92,110,0.24) 0%, rgba(14,26,30,0.58) 44%, rgba(10,16,18,0.36) 100%);
      box-shadow: 0 16px 36px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.06);
      overflow: hidden;
    }

    /* Form card: keep readable contrast (match overall dark UI) */
    .formCard{
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(220,235,240,0.16);
      border-radius: 22px;
      padding: 26px;
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 60px rgba(0,0,0,.35);
    }

    .formCard .cardHead{ border-bottom: 1px solid rgba(220,235,240,0.10); }
    .formCard .k{ color: rgba(220,235,240,0.78); }
    .formCard .mini{ color: rgba(220,235,240,0.62); }

    .formCard label{ color: rgba(220,235,240,0.70); }
    .formCard .consent{ color: rgba(220,235,240,0.66); }
    .formCard .hint{ color: rgba(220,235,240,0.58); }
    .formCard .status{ color: rgba(220,235,240,0.62); }
    .formCard .status[data-ok="1"]{ color: rgba(80,220,170,0.92); }
    .formCard .status[data-ok="0"]{ color: rgba(255,120,120,0.92); }

    .formCard input, .formCard select, .formCard textarea{
      border-color: rgba(220,235,240,0.18);
      background: rgba(255,255,255,0.08);
      color: rgba(245,250,252,0.94);
    }

    /* Make native dropdown options readable (some browsers render <option> on a light panel). */
    .formCard select{ color-scheme: dark; }
    .formCard select option,
    .formCard select optgroup{
      background: rgba(8,14,18,0.98) !important;
      color: rgba(245,250,252,0.94) !important;
    }
    .formCard input::placeholder, .formCard textarea::placeholder{
      color: rgba(220,235,240,0.40);
    }
    .formCard input:focus, .formCard select:focus, .formCard textarea:focus{
      border-color: rgba(0,170,200,0.60);
      box-shadow: 0 0 0 3px rgba(0,140,170,0.18);
    }

    /* Smaller submit button */
    .formCard .btn{
      padding: 8px 12px;
      font-size: 13px;
      border-color: rgba(220,235,240,0.16);
      background: rgba(255,255,255,0.06);
      color: rgba(240,252,255,0.86);
    }
    .formCard .btn.primary{
      background: rgba(0,140,170,0.18);
      color: rgba(240,252,255,0.96);
      border-color: rgba(0,170,200,0.28);
    }

    .cardHead{ padding: 14px 16px; border-bottom: 1px solid rgba(220,235,240,0.08); }
    .k{ font-size: 12px; letter-spacing: .12em; color: rgba(220,235,240,0.78); }
    .mini{ margin-top: 6px; color: rgba(220,235,240,0.62); line-height: 1.6; font-size: 12px; }

    .formCard .form{ padding: 16px; display:flex; flex-direction:column; gap: 12px; }
    .row{ display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }

    .field{ display:flex; flex-direction:column; gap: 6px; }
    label{ font-size: 12px; color: rgba(220,235,240,0.66); letter-spacing: .06em; }
    .req{ color: rgba(255,170,170,0.82); }

    input, select, textarea{
      width:100%;
      padding: 10px 12px;
      border-radius: 12px;
      border: 1px solid rgba(220,235,240,0.12);
      background: rgba(10,22,26,0.18);
      color: rgba(240,252,255,0.92);
      outline:none;
    }
    textarea{ resize: vertical; }
    input:focus, select:focus, textarea:focus{ border-color: rgba(220,235,240,0.24); }

    .consent{ display:flex; gap: 10px; align-items:flex-start; color: rgba(220,235,240,0.66); line-height: 1.7; font-size: 12px; }
    .consent input{ margin-top: 3px; width: 14px; height: 14px; }

    .actions{ display:flex; gap: 10px; align-items:center; flex-wrap: wrap; }
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      padding: 9px 14px; border-radius: 999px;
      border: 1px solid rgba(220,235,240,0.14);
      color: rgba(220,235,240,0.88);
      text-decoration:none;
      background: rgba(10,22,26,0.10);
    }
    .btn.primary{ background: rgba(240,252,255,0.92); color: rgba(10,22,26,0.92); border-color: rgba(240,252,255,0.92); font-weight: 700; }

    .status{ font-size: 12px; color: rgba(220,235,240,0.66); }
    .status[data-ok="1"]{ color: rgba(120,255,210,0.78); }
    .status[data-ok="0"]{ color: rgba(255,160,160,0.78); }

    .replyTime{ margin-top: 10px; color: rgba(220,235,240,0.62); font-size: 12px; line-height: 1.6; }

    .hint{ color: rgba(220,235,240,0.62); font-size: 12px; line-height: 1.8; }
    .inline{ color: rgba(240,252,255,0.92); }

    .sideCard .links{ padding: 16px; display:flex; flex-direction:column; gap: 10px; }
    .linkRow{ display:flex; justify-content:space-between; gap: 10px; padding: 12px 12px; border-radius: 16px; border: 1px solid rgba(220,235,240,0.10); background: rgba(10,22,26,0.10); text-decoration:none; }
    .t{ color: rgba(240,252,255,0.92); font-weight: 600; }
    .s{ color: rgba(220,235,240,0.62); font-size: 12px; }
    .small{ padding: 0 16px 16px; color: rgba(220,235,240,0.62); font-size: 12px; line-height: 1.8; }

    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
      .row{ grid-template-columns: 1fr; }
      .h1{ font-size: 36px; }
    }
  
    /* Readability: lighter fields on dark background */
    .formCard input, .formCard textarea, .formCard select{
      background: rgba(255,255,255,0.09);
      border: 1px solid rgba(220,235,240,0.18);
      color: var(--fg0);
    }
    /* Native <select> dropdown options: ensure readable contrast in Windows/Chromium */
    .formCard select{ color-scheme: dark; }
    .formCard select option, .formCard select optgroup{
      background: rgba(10,22,26,0.98) !important;
      color: rgba(240,252,255,0.92) !important;
    }
    .formCard input::placeholder, .formCard textarea::placeholder{
      color: rgba(230,240,245,0.55);
    }
    .formCard input:focus, .formCard textarea:focus, .formCard select:focus{
      outline: none;
      border-color: rgba(76, 217, 200, 0.55);
      box-shadow: 0 0 0 4px rgba(76, 217, 200, 0.14);
    }

  </style>
</Base>
