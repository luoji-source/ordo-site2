---
import Base from '@/layouts/Base.astro';
import { marked } from 'marked';
import { local } from '@/lib/local-store';

let updates: any[] = [];
if (import.meta.env.DEV) {
  updates = local.updates.en;
} else {
  const res = await fetch(new URL('/api/public/updates?lang=en', Astro.url));
  const json = await res.json().catch(() => ({ ok: false, data: [] }));
  updates = json?.data ?? [];
}
---
<Base lang="en" title="Updates | ORDO">
  <section style="margin-top:18px">
    <h1 style="margin:0 0 8px">Updates</h1>
    <p class="muted" style="margin:0 0 16px">Manufacturing progress / version updates / delivery logs.</p>

    {updates.length === 0 ? (
      <div class="card">No updates yet (publish from /admin).</div>
    ) : (
      <div style="display:flex;flex-direction:column;gap:12px">
        {updates.map((u) => (
          <article class="card">
            <div class="muted">{u.date} · {u.version ?? ''}{u.batch ? ` · ${u.batch}` : ''}</div>
            <h2 style="margin:8px 0 6px;font-size:20px">{u.title}</h2>
            <div class="muted" set:html={marked.parse(u.body_md || '')} />
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
