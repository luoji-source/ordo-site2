---
import Base from '@/layouts/Base.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { local } from '@/lib/local-store';

let products: any[] = [];
if (import.meta.env.DEV) {
  products = local.products.en;
} else {
  const res = await fetch(new URL('/api/public/products?lang=en', Astro.url));
  const json = await res.json().catch(() => ({ ok: false, data: [] }));
  products = json?.data ?? [];
}
const byStatus = (s) => products.filter((p) => p.status === s);
---
<Base lang="en" title="Products | ORDO">
  <section style="margin-top:18px">
    <h1 style="margin:0 0 8px">Products</h1>
    <p class="muted" style="margin:0 0 16px">Active / Preview / Proven + Version & Batch.</p>
    <div class="grid">
      <div class="col12 card">
        <div class="muted">Product Continuum</div>
        <div style="margin-top:10px">Reading → Marking → Slideway → Responsibility</div>
      </div>
    </div>
  </section>

  <section style="margin-top:14px">
    <h2 style="margin:0 0 10px">Active</h2>
    <div class="grid">
      {byStatus('active').map((p) => (
        <a class="card col6" href={`/en/products/${p.slug}`}>
          <ImagePlaceholder width={p.image?.width ?? 1200} height={p.image?.height ?? 800} label={p.image?.label ?? 'Product image'} />
          <div class="muted">{p.version} · {p.batch}</div>
          <div style="font-size:20px;margin-top:8px">{p.name}</div>
          <div class="muted" style="margin-top:6px">{p.summary}</div>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:14px">
    <h2 style="margin:0 0 10px">Preview</h2>
    <div class="grid">
      {byStatus('preview').map((p) => (
        <a class="card col6" href={`/en/products/${p.slug}`}>
          <ImagePlaceholder width={p.image?.width ?? 1200} height={p.image?.height ?? 800} label={p.image?.label ?? 'Product image'} />
          <div class="muted">{p.version} · {p.batch}</div>
          <div style="font-size:20px;margin-top:8px">{p.name}</div>
          <div class="muted" style="margin-top:6px">{p.summary}</div>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top:14px">
    <h2 style="margin:0 0 10px">Proven</h2>
    <div class="grid">
      {byStatus('proven').map((p) => (
        <a class="card col6" href={`/en/products/${p.slug}`}>
          <ImagePlaceholder width={p.image?.width ?? 1200} height={p.image?.height ?? 800} label={p.image?.label ?? 'Product image'} />
          <div class="muted">{p.version} · {p.batch}</div>
          <div style="font-size:20px;margin-top:8px">{p.name}</div>
          <div class="muted" style="margin-top:6px">{p.summary}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
