---
import Base from '@/layouts/Base.astro';

const pageTitle = 'Shop';
const pageDesc =
  'Online shop: email ordering / confirmation. We don’t sell a “risk story” — we publish transparent milestones.';

const orderEmail = 'orders@ordoinc.com';

const mailto = (to: string, subject: string, body: string) => {
  const s = encodeURIComponent(subject);
  const b = encodeURIComponent(body);
  return `mailto:${to}?subject=${s}&body=${b}`;
};

const featured = {
    name: 'Line Pointer',
  series: 'Wind / Fire / Thunder / Electric',
  subtitle: 'ORDO Mark v1.0 Standard Set',
  blurb:
    'An engineering‑grade reading marker you can slide. Not decoration: it compresses real structure, tactile feedback, and carbon‑fiber material into books and documents.',
  uses: [
    'Interrupted reading: next time you open, you’re back to the same spot — instantly',
    'Revisiting long docs / notes: use the scale to mark “progress”',
    'Study / training: turn the “current paragraph” into a reproducible position',
  ],
  images: [
    // Keep image set consistent with /zh/shop
    { src: '/images/home/reading-locator-hero.jpg', alt: 'Line Pointer — set' },
    { src: '/images/home/slide-structure-960.png', alt: 'Mark core structure — slot + scale' },
    { src: '/images/explain-reading-scene-960.png', alt: 'Reading scene — handoff and return' },
  ],
  orderCta: 'Order',
  detailCta: 'Details',
  orderHref: mailto(
    orderEmail,
    'Order | ORDO Mark v1.0 (Set of Four)',
    'Hi ORDO,\n\nI’d like to order: ORDO Mark v1.0 (Wind / Fire / Thunder / Electric)\n\nName:\nRegion / Address:\nPhone (optional):\n\nNotes (optional):\n\nThanks.'
  ),
  detailHref: '/en/shop/reading-locator',
};

const previews = [
  {
    title: 'Marking Locator Ruler',
    badge: 'Preview',
    desc: 'I’ll never forget what size I measured last time.',
    chips: ['Preview', 'Prototype', 'Subscribe'],
    link: 'Subscribe →',
    href: mailto(
      orderEmail,
      'Subscribe | Marking Locator Ruler',
      'Hi ORDO,\n\nPlease add me to updates for: Marking Locator Ruler\n\nName:\nRegion:\n\nThanks.'
    ),
    hint: 'Price not listed',
  },
  {
    title: 'Family Outing Board',
    badge: 'Preview',
    desc: 'Nothing keeps me worried when I leave home.',
    chips: ['Preview', 'In design', 'Subscribe'],
    link: 'Subscribe →',
    href: mailto(
      orderEmail,
      'Subscribe | Family Outing Board',
      'Hi ORDO,\n\nPlease add me to updates for: Family Outing Board\n\nName:\nRegion:\n\nThanks.'
    ),
    hint: 'Price not listed',
  },
];
---

<Base title={pageTitle} desc={pageDesc} lang="en">
  <main class="page">
    <section class="section hero">
      <div class="section__head">
        <h2 class="h2">Featured</h2>
      </div>

      <div class="featured">
        <div class="featured__media" data-gallery="featured">
          <div class="gallery">
            <div class="galleryMain" role="button" tabindex="0" aria-label="Click to zoom. Move the mouse to pan.">
              <img
                id="featuredMainImg"
                src={featured.images[0].src}
                alt={featured.images[0].alt}
                loading="eager"
              />
            </div>
            <div class="thumbs" role="list" aria-label="Thumbnails">
              {featured.images.map((img, i) => (
                <button
                  class={"thumb" + (i === 0 ? ' isActive' : '')}
                  type="button"
                  role="listitem"
                  aria-label={`Thumbnail ${i + 1}`}
                  data-src={img.src}
                  data-alt={img.alt}
                >
                  <img src={img.src} alt={img.alt} loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="featured__body">
          <div class="titleBlock">
            <div class="h3">
              <span class="prodName">{featured.name}</span>
              <span class="prodSeries"> · {featured.series}</span>
            </div>
            <div class="subtitle">{featured.subtitle}</div>
          </div>

          <p class="tagline">{featured.blurb} You’ll use it for:</p>
          <ul class="points">
            {featured.uses.map((t) => (
              <li>{t}</li>
            ))}
          </ul>

          <div class="cta">
            <a class="btn" href={featured.orderHref}>
              {featured.orderCta}
            </a>
            <a class="btn ghost" href={featured.detailHref}>
              {featured.detailCta}
            </a>
          </div>
            </div>
      </div>
    </section>

    <section class="section">
      <div class="subhead">
        <div>
          <div class="h3s">Preview items</div>

        </div>
      </div>

      <div class="grid grid--pre">
        {previews.map((p) => (
          <div class="card shop-card">
            <div class="card__top">
              <div class="card__title">{p.title}</div>
              <span class="status status--pre">{p.badge}</span>
            </div>
            <div class="card__desc">{p.desc}</div>
            <div class="chips">
              {p.chips.map((c) => (
                <span class="chip">{c}</span>
              ))}
            </div>
            <div class="card__footer">
              <a class="link" href={p.href}>
                {p.link}
              </a>
              <div class="hint">{p.hint}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-gallery="featured"]');
      if (!root) return;

      const mainImg = root.querySelector('#featuredMainImg');
      const thumbs = Array.from(root.querySelectorAll('.thumb'));
      if (!mainImg || !thumbs.length) return;

      const main = root.querySelector('.galleryMain');

      const setZoomSrc = (src) => {
        if (!main) return;
        main.style.setProperty('--zoom-src', `url("${src}")`);
      };

      const zoomOn = () => {
        if (!main) return;
        main.classList.add('isZoomed');
        main.style.backgroundImage = 'var(--zoom-src)';
        main.style.backgroundPosition = '50% 50%';
      };

      const zoomOff = () => {
        if (!main) return;
        main.classList.remove('isZoomed');
        main.style.backgroundImage = 'none';
        main.style.backgroundPosition = '50% 50%';
      };

      const toggleZoom = () => {
        if (!main) return;
        if (main.classList.contains('isZoomed')) zoomOff();
        else zoomOn();
      };

      const updateBgPos = (e) => {
        if (!main) return;
        const rect = main.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        const clamp = (v) => Math.max(0, Math.min(100, v));
        main.style.backgroundPosition = `${clamp(x)}% ${clamp(y)}%`;
      };

      const setActive = (src) => {
        thumbs.forEach((b) => {
          b.classList.toggle('isActive', b.getAttribute('data-src') === src);
        });
      };

      const setMain = (src, alt) => {
        mainImg.src = src;
        mainImg.alt = alt || '';
        setActive(src);
        setZoomSrc(src);
        if (main && main.classList.contains('isZoomed')) {
          main.style.backgroundImage = 'var(--zoom-src)';
          main.style.backgroundPosition = '50% 50%';
        }
      };

      thumbs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = btn.getAttribute('data-src');
          const alt = btn.getAttribute('data-alt') || '';
          if (src) setMain(src, alt);
        });
      });



      // Zoom interaction: click to toggle, move to pan
      if (main) {
        main.addEventListener('click', (e) => {
          // Avoid accidental text selection
          e.preventDefault();
          toggleZoom();
        });

        main.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleZoom();
          }
        });

        main.addEventListener('mousemove', (e) => {
          if (!main.classList.contains('isZoomed')) return;
          updateBgPos(e);
        });

        main.addEventListener('mouseleave', () => {
          if (!main.classList.contains('isZoomed')) return;
          main.style.backgroundPosition = '50% 50%';
        });
      }

      setZoomSrc(mainImg.getAttribute('src') || '');
      setActive(mainImg.getAttribute('src') || '');
    })();
  </script>

  <style>
    .shop-card{ min-height:168px; display:flex; flex-direction:column; gap:10px; }

    .k{font-size:12px;letter-spacing:.22em;opacity:.7;margin-bottom:10px;}
    
    .sub{max-width:920px;margin:0 0 18px;opacity:.9;font-size:16px;line-height:1.7;}
    .pill{display:inline-flex;align-items:center;padding:7px 12px;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(0,0,0,.18);font-size:13px;opacity:.9}

    .section{padding:26px 0;}
    .section__head{max-width:1100px;margin:0 auto 16px;padding:0 28px;}
    .h2{font-size:22px;margin:0 0 6px;}
    .desc{margin:0;opacity:.82;line-height:1.7;max-width:980px;}

    .featured{max-width:1100px;margin:0 auto;padding:18px;border:1px solid rgba(255,255,255,.12);border-radius:22px;background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));backdrop-filter: blur(10px);display:grid;grid-template-columns: .95fr 1.05fr;gap:18px;}

    .featured__media{min-width:0;}
    .gallery{display:block;}
    .galleryMain{aspect-ratio:16/10;max-height:340px;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.10);background:rgba(0,0,0,.2);position:relative;--zoom-src:none;background-image:none;background-repeat:no-repeat;background-position:50% 50%;background-size:cover;cursor:zoom-in;}
    .galleryMain img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .12s ease;}
    .galleryMain.isZoomed{cursor:zoom-out;background-image:var(--zoom-src);background-size:200%;}
    .galleryMain.isZoomed img{opacity:0;}
    /* Thumbnails: up to 6. Keep them compact so 6 items visually align with the main image block. */
    .thumbs{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-start;}
    /* Each thumbnail takes 1/6 of the main image width so 6 items align cleanly. */
    .thumb{flex:0 0 calc((100% - 5*8px)/6);max-width:calc((100% - 5*8px)/6);border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.2);opacity:.82;cursor:pointer;padding:0;max-height:56px;}
    .thumb:hover{opacity:1;}
    .thumb.isActive{opacity:1;border-color:rgba(255,255,255,.28);}
    .thumb img{width:100%;height:56px;aspect-ratio:16/10;object-fit:cover;display:block;}

    .featured__body{padding:16px 14px 16px 8px;display:flex;flex-direction:column;gap:14px;justify-content:center;}
    .badge{align-self:flex-start;font-size:12px;letter-spacing:.08em;padding:6px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(0,0,0,.22);opacity:.9}
    .h3{margin:0;font-size:22px;line-height:1.15;display:flex;align-items:baseline;gap:12px;flex-wrap:nowrap;min-width:0;}
    .titleBlock{display:flex;flex-direction:column;gap:6px;}
    /* Make the product name more prominent than the series label (matches the site's typographic hierarchy). */
    .titleBlock .prodName{font-size:28px;font-weight:820;letter-spacing:.02em;white-space:nowrap;}
    .titleBlock .prodSeries{font-size:16px;opacity:.78;font-weight:680;letter-spacing:.02em;white-space:nowrap;}
    .subtitle{margin:6px 0 0;font-size:15px;line-height:1.45;font-weight:650;letter-spacing:.06em;color:rgba(214,244,250,.86);opacity:.92;}
    .subhead{max-width:1100px;margin:0 auto 10px;padding:0 28px;display:flex;align-items:baseline;justify-content:space-between;gap:14px;}
    .h3s{margin:0;font-size:14px;letter-spacing:.08em;opacity:.92;}
    .subdesc{font-size:12px;opacity:.72;line-height:1.6;}
    .muted{opacity:.78;font-weight:500;}
    .tagline{margin:0;opacity:.9;line-height:1.7;}
    .points{margin:0;padding-left:18px;opacity:.86;line-height:1.7;}

    .cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px;}
    .btn:hover{background:rgba(255,255,255,.06)}
    .btn.ghost{opacity:.85}
    .fine{font-size:12px;opacity:.72;line-height:1.7;margin-top:2px;}

    .grid{max-width:1100px;margin:0 auto;padding:0 28px;display:grid;grid-template-columns:repeat(4, minmax(0,1fr));gap:14px;}
    .grid--pre{grid-template-columns:repeat(2, minmax(0,1fr));}
    .grid--plan{grid-template-columns:repeat(3, minmax(0,1fr));}
    .card__top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
    .card__title{font-size:16px;font-weight:700;}
    .status{font-size:12px;padding:5px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.14);opacity:.92;white-space:nowrap;}
    .status--pre{background:rgba(255,255,255,.06)}
    .status--plan{background:rgba(0,0,0,.18);opacity:.8}
    .card__desc{opacity:.82;line-height:1.65;font-size:13px;}
    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:auto;}
    .chip{font-size:12px;opacity:.8;padding:5px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.14)}
    .card__footer{display:flex;align-items:center;justify-content:space-between;margin-top:2px;}
    .link{font-size:13px;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.22);padding-bottom:2px;}
    .hint{font-size:12px;opacity:.65;}

    .bottomNote{max-width:1100px;margin:14px auto 0;padding:0 28px;font-size:12px;opacity:.7;}

    @media (max-width: 980px){
      .featured{grid-template-columns: 1fr;}
      .grid{grid-template-columns:repeat(2, minmax(0,1fr));}
      .grid--pre{grid-template-columns:repeat(2, minmax(0,1fr));}
      .grid--plan{grid-template-columns:repeat(2, minmax(0,1fr));}
      
    }
    @media (max-width: 560px){
      .grid{grid-template-columns:1fr;}
      .grid--pre{grid-template-columns:1fr;}
      .grid--plan{grid-template-columns:1fr;}
      
      .h3{flex-wrap:wrap;}
      .titleBlock .prodName{white-space:normal;}
      .titleBlock .prodSeries{white-space:normal;font-size:14px;}
    }
  </style>
</Base>
