---
import Base from "@/layouts/Base.astro";

const qp = Astro.url.searchParams;
const rawType = (qp.get("type") || qp.get("topic") || "").toLowerCase();
const typeWhitelist = ["sales", "software", "support", "procurement", "partnership", "media"];
const presetType = typeWhitelist.includes(rawType) ? rawType : "support";
---

<Base lang="zh" title="支持与联系 · ORDO">
  <section class="page">
    <div class="container">
      <header class="hero">
        <h1 class="h1">支持与联系</h1>
        <p class="lead">
          用一条清晰信息开始对话。我们不使用自动推销回复；你提交的内容只用于与你沟通。
        </p>
      </header>

      <div class="grid">
        <main class="card formCard" aria-label="在线留言表单">
          <div class="cardHead">
            <div class="k">在线留言</div>
            <div class="mini">用于购买咨询、软件与硬件支持、合作提案</div>
          </div>

          <form id="supportForm" class="form" autocomplete="on">
            <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" /><div class="row">
              <div class="field">
                <label for="name">姓名</label>
                <input id="name" name="name" type="text" placeholder="你的称呼" required minlength="2" maxlength="40" />
              </div>
              <div class="field">
                <label for="email">邮箱 <span class="req">*</span></label>
                <input id="email" name="email" type="email" placeholder="name@example.com" required maxlength="120" />
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="org">组织/公司</label>
                <input id="org" name="org" type="text" placeholder="可选" maxlength="80" />
              </div>
              <div class="field">
                <label for="type">主题</label>
                <select id="type" name="type">
                  <option value="support" selected={presetType === "support"}>支持 / 售后</option>
                  <option value="software" selected={presetType === "software"}>软件 获取 / 授权</option>
                  <option value="sales" selected={presetType === "sales"}>购买咨询（硬件/软件）</option>
                  <option value="procurement" selected={presetType === "procurement"}>采购 / 发票 / 对公</option>
                  <option value="partnership" selected={presetType === "partnership"}>合作 / 渠道</option>
                  <option value="media" selected={presetType === "media"}>媒体 / 采访</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="subject">标题</label>
              <input id="subject" name="subject" type="text" placeholder="例如：购买与授权方式" required minlength="4" maxlength="80" />
            </div>

            <div class="field">
              <label for="message">内容 <span class="req">*</span></label>
              <textarea
                id="message"
                name="message"
                rows="7"
                placeholder="建议包含：你要解决的事 / 当前状态 / 你希望的交付方式（购买/下载/合作/售后）"
               
                required
                minlength="20"
                maxlength="2000"
              ></textarea>
            </div>

            <label class="consent">
              <input id="consent" name="consent" type="checkbox" required />
              <span>我同意 ORDO 使用以上信息与我联系（仅用于本次沟通，不做广告群发）。</span>
            </label>

            <div class="actions">
              <button id="submitBtn" class="btn primary" type="submit">提交留言</button>
              <div id="status" class="status" role="status" aria-live="polite"></div>
            </div>

            <div class="replyTime" aria-hidden="true">我们会在 24–48 小时内回复。</div>

            <div class="hint">
              提示：如果涉及硬件批次/交付，请附上订单信息或批次号；如果涉及软件版本，请附上版本号（见 <a class="inline" href="/zh/releases">发布页</a>）。
            </div>
          </form>
        </main>

        <aside class="side" aria-label="常用入口">
          <section class="card sideCard">
            <div class="cardHead">
              <div class="k">常用入口</div>
              <div class="mini">让对话更快落地为事实</div>
            </div>

            <div class="links">
              <a class="linkRow" href="/zh/shop">
                <span class="t">硬件商城</span>
                <span class="s">购买与邮件确认</span>
              </a>
              <a class="linkRow" href="/zh/software">
                <span class="t">软件</span>
                <span class="s">下载/授权/版本事实</span>
              </a>
              <a class="linkRow" href="/zh/releases">
                <span class="t">发布记录</span>
                <span class="s">版本与变更的事实来源</span>
              </a>
              <a class="linkRow" href="/zh/manufacturing">
                <span class="t">制造与验收</span>
                <span class="s">工艺与交付核对</span>
              </a>
            </div>

            <div class="small">
              我们优先处理：影响使用安全/数据安全、影响交付、影响判断准确性的事项。
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('supportForm');
    const status = document.getElementById('status');
    const btn = document.getElementById('submitBtn');
    const website = document.getElementById('website');
    // 用于服务端的防机器人时间阈值：必须是页面加载时间，而不是提交时间。
    const pageLoadedAt = Date.now();
    // Honeypot should stay hidden.
    website.style.position = 'absolute';
    website.style.left = '-9999px';
    website.style.opacity = '0';

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStatus(text, ok, requestId = '') {
      status.dataset.ok = ok ? '1' : '0';
      if (!requestId) {
        status.textContent = text;
        return;
      }

      const rid = String(requestId);
      status.innerHTML = `${escapeHtml(text)} <span class="reqid">(ID: <button type="button" class="copy-id" data-id="${escapeHtml(rid)}">${escapeHtml(rid)}</button>)</span>`;
      const btn = status.querySelector('.copy-id');
      if (btn) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.getAttribute('data-id') || '');
            btn.textContent = '已复制';
            setTimeout(() => (btn.textContent = rid), 1200);
          } catch (_) {
            // ignore
          }
        }, { once: true });
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('正在提交…', true);
      btn.disabled = true;

      const fd = new FormData(form);
      const payload = {
        locale: 'zh',
        source: 'website',
        ts: pageLoadedAt,
        website: String(fd.get('website') || ''),
        type: String(fd.get('type') || 'support'),
        // Backward/forward compatible: backend may read `topic`.
        topic: String(fd.get('type') || 'support'),
        name: String(fd.get('name') || ''),
        email: String(fd.get('email') || ''),
        organization: String(fd.get('org') || ''),
        subject: String(fd.get('subject') || ''),
        message: String(fd.get('message') || ''),
        // 服务端期望 `agree`（boolean）。表单里仍用 consent 作为勾选项的 name。
        agree: fd.get('consent') === 'on',
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json?.ok === false) {
          const msg = json?.error || '提交失败，请稍后再试。';
          setStatus(msg, false);
          btn.disabled = false;
          return;
        }

        setStatus('提交成功。我们将尽快回复。', true, json?.requestId || '');
        form.reset();
      } catch (err) {
        setStatus('网络异常：未能提交。请稍后重试。', false);
        btn.disabled = false;
      }
    });
  </script>

  <style>

    .hero{ padding-top: 10px; }

    .lead{ margin: 12px 0 0; color: rgba(220,235,240,.72); line-height: 1.75; max-width: 92ch; }

    .grid{ margin-top: 16px; display:grid; grid-template-columns: 1.2fr 0.8fr; gap: 12px; align-items: start; }

    

    /* Form card: keep readable contrast (match overall dark UI) */
    .formCard{
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(220,235,240,0.18);
      border-radius: 22px;
      padding: 26px;
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 60px rgba(0,0,0,.35);
    }
    .formCard .cardHead{ border-bottom: 1px solid rgba(220,235,240,0.10); }
    .formCard .k{ color: rgba(220,235,240,0.92); }
    .formCard .mini{ color: rgba(220,235,240,0.60); }

    .formCard label{ color: rgba(220,235,240,0.72); }
    .formCard .consent{ color: rgba(220,235,240,0.70); }
    .formCard .hint{ color: rgba(220,235,240,0.60); }
    .formCard .status{ color: rgba(220,235,240,0.66); }
    .formCard .status[data-ok="0"]{ color: rgba(255,180,180,0.88); }

    .formCard input, .formCard textarea, .formCard select{
      background: rgba(255,255,255,0.09);
      border: 1px solid rgba(220,235,240,0.18);
      color: var(--fg0);
    }

    /* 下拉选项在部分浏览器会使用浅色面板，这里强制提高可读性 */
    .formCard select{ color-scheme: dark; }
    .formCard select option,
    .formCard select optgroup{
      background: rgba(10,22,26,0.98) !important;
      color: rgba(245,250,252,0.92) !important;
    }
    .formCard input::placeholder, .formCard textarea::placeholder{
      color: rgba(230,240,245,0.55);
    }
    .formCard input:focus, .formCard textarea:focus, .formCard select:focus{
      outline: none;
      border-color: rgba(76,217,200,0.55);
      box-shadow: 0 0 0 4px rgba(76,217,200,0.14);
    }

    .formCard .btn.primary{
      background: rgba(12,16,18,0.86);
      color: rgba(245,250,252,0.96);
      border-color: rgba(12,16,18,0.86);
    }

/* Form layout */
    .cardHead{ padding: 16px 16px 12px; border-bottom: 1px solid rgba(220,235,240,0.08); }
    .k{ font-weight: 800; color: rgba(220,235,240,0.92); letter-spacing: 0.08em; font-size: 12px; }
    .mini{ margin-top: 6px; font-size: 12px; color: rgba(220,235,240,.60); line-height: 1.6; }

    .form{ padding: 16px; display:flex; flex-direction:column; gap: 12px; }
    .row{ display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .field{ display:flex; flex-direction:column; gap: 8px; }
    label{ font-size: 12px; color: rgba(220,235,240,0.72); letter-spacing: 0.06em; }
    input, select, textarea{
      border-radius: 14px;
      border: 1px solid rgba(220,235,240,0.18);
      background: rgba(255,255,255,0.06);
      padding: 10px 12px;
      color: rgba(240,252,255,0.92);
      outline: none;
    }
    textarea{ resize: vertical; min-height: 140px; }
    input:focus, select:focus, textarea:focus{ border-color: rgba(240,252,255,0.32); box-shadow: 0 0 0 3px rgba(112,180,210,0.14); }
    .req{ color: rgba(255,180,180,0.92); font-weight: 700; }

    .consent{ display:flex; gap: 10px; align-items:flex-start; color: rgba(220,235,240,0.70); font-size: 12px; line-height: 1.6; }
    .consent input{ margin-top: 3px; }

    .actions{ display:flex; align-items:center; gap: 12px; flex-wrap: wrap; }
    .status{ font-size: 12px; color: rgba(220,235,240,0.66); }
    .status[data-ok="1"]{ color: rgba(120,255,210,0.78); }
    .status[data-ok="0"]{ color: rgba(255,180,180,0.88); }
    .status .rid{ margin-left: 6px; opacity: 0.9; }
    .status .copy-id{
      appearance: none;
      border: 0;
      padding: 0;
      margin: 0;
      background: transparent;
      color: inherit;
      text-decoration: underline;
      cursor: pointer;
      font: inherit;
    }

    .replyTime{ margin-top: 10px; color: rgba(220,235,240,0.62); font-size: 12px; line-height: 1.6; }

    .hint{ margin-top: 6px; font-size: 12px; color: rgba(220,235,240,0.60); line-height: 1.7; }
    .inline{ color: rgba(240,252,255,0.92); text-underline-offset: 2px; }

    .sideCard{ padding-bottom: 10px; }
    .links{ padding: 12px 16px 8px; display:flex; flex-direction:column; gap: 8px; }
    .linkRow{
      display:flex; justify-content:space-between; gap: 12px;
      padding: 10px 12px;
      border-radius: 16px;
      border: 1px solid rgba(220,235,240,0.10);
      background: rgba(255,255,255,0.06);
      text-decoration:none;
      color: rgba(240,252,255,0.90);
    }
    .t{ font-size: 13px; }
    .s{ font-size: 12px; color: rgba(220,235,240,0.60); white-space: nowrap; }
    .small{ padding: 0 16px 14px; font-size: 12px; color: rgba(220,235,240,0.60); line-height: 1.7; }

    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }
    @media (max-width: 680px){

      .row{ grid-template-columns: 1fr; }
      .s{ white-space: normal; }
    }

  </style>
</Base>
