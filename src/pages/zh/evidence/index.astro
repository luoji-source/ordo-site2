---
const to = "/zh/manufacturing";
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
    <title>页面已迁移 · ORDO</title>
    <script is:inline>
      // Prefer an actual redirect in the browser for static hosting.
      window.location.replace("/zh/manufacturing");
    </script>
  </head>
  <body style="font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial; padding:24px;">
    <p>此页面已迁移至：<a href={to}>/zh/manufacturing</a></p>
  </body>
</html>
