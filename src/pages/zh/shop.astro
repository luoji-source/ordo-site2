---
import Base from "@/layouts/Base.astro";

const orderEmail = "order@ordoinc.com";

function safeText(v, fallback = "") {
  return typeof v === "string" && v.trim().length ? v : fallback;
}

// ✅ 来自首页推荐产品模块（移植到商店顶部）
const pNameZh = "连续事实标定器 · 阅读场景";
const pLine1 = "风火雷电系列";
const pLine2 = "滑道式 · 碳纤维";
const pVersion = "v1.1";

// 占位：主图尺寸提示
const heroSetMeta = { w: 1100, h: 825, label: "四枚并排主图（占位）" };

// 文案占位（保持首页结构）
const hero = {
  subtitle: "用于标定阅读过程中“当前停留位置”的实体器具",
  micro: "不是装饰，不记录数据，不提醒你阅读",
  orderHint: "下单邮件写：姓名 / 地址 / 数量（默认 1 套装）",
};

const orderHref = `mailto:${orderEmail}?subject=${encodeURIComponent(`ORDO 下单 / ${pNameZh} ${pVersion}`)}`;
const contactHref = `mailto:${orderEmail}?subject=${encodeURIComponent("ORDO 咨询 / 商店")}`;
---

<Base lang="zh" title="商店 · ORDO">
  <!-- 顶部：移植首页推荐产品板块 -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">ORDO · 新推出产品</div>

          <h1 class="h1 nowrap" title={pNameZh}>{pNameZh}</h1>

          <div class="sub">{safeText(hero.subtitle, "用于标定阅读过程中“当前停留位置”的实体器具")}</div>
          <div class="micro">{safeText(hero.micro, "不是装饰，不记录数据，不提醒你阅读")}</div>

          <div class="spec">
            <div class="spec-row"><span class="k">系列</span><span class="v">{pLine1}</span></div>
            <div class="spec-row"><span class="k">形式</span><span class="v">{pLine2}</span></div>
            <div class="spec-row"><span class="k">版本</span><span class="v">{pVersion}</span></div>
          </div>

          <div class="cta-row">
            <a class="btn primary" href={orderHref}>下单</a>
            <a class="btn" href={contactHref}>咨询</a>
          </div>

          <div class="order-hint">{safeText(hero.orderHint, "下单邮件写：姓名 / 地址 / 数量（默认 1 套装）")}</div>
        </div>

        <div class="hero-media">
          <div class="ph-fit ph-hero ruler" role="img" aria-label="四枚并排主图占位">
            <div class="ph-inner">
              <div class="ph-top">
                <span class="tag">主图 / 四枚并排</span>
                <span class="dim">参考尺寸：{heroSetMeta.w}×{heroSetMeta.h}px</span>
              </div>
              <div class="ph-mid">
                <div class="ph-title">{heroSetMeta.label}</div>
                <div class="ph-sub">{pNameZh}</div>
              </div>
              <div class="ph-bottom">
                <span class="muted">{pVersion}</span>
                <span class="muted">4:3</span>
              </div>
            </div>
          </div>
          <div class="media-note">主图与左侧功能描述对齐；比例 4:3。</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 下部：标准电商展示区（8 个：2 个预告 + 6 个规划） -->
  <section class="catalog">
    <div class="container">
      <div class="catalog-head">
        <h2 class="h2b">全部产品</h2>
        <div class="catalog-note">本页展示在售/预告/规划产品。预告与规划不披露可对标参数，以交付节点与事实口径为准。</div>
      </div>

      <div class="grid">
        <!-- 预告 01 -->
        <article class="card">
          <div class="thumb">01</div>
          <div class="card-top">
            <h3 class="title">预告产品 A（占位）</h3>
            <span class="badge presale">预告</span>
          </div>
          <p class="text">以节点透明的方式发布；上线前仅公开边界与可核对口径。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>登记意向</a>
          </div>
        </article>

        <!-- 预告 02 -->
        <article class="card">
          <div class="thumb">02</div>
          <div class="card-top">
            <h3 class="title">预告产品 B（占位）</h3>
            <span class="badge presale">预告</span>
          </div>
          <p class="text">保持“可核对事实”叙事，不做对标式宣传与参数堆叠。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>登记意向</a>
          </div>
        </article>

        <!-- 规划 03 -->
        <article class="card">
          <div class="thumb">03</div>
          <div class="card-top">
            <h3 class="title">规划产品 01（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">公开“要解决的问题”与“核对方式”，不公开可被对标的实现细节。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>

        <!-- 规划 04 -->
        <article class="card">
          <div class="thumb">04</div>
          <div class="card-top">
            <h3 class="title">规划产品 02（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">以交付事实为中心：边界、节点、验收口径。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>

        <!-- 规划 05 -->
        <article class="card">
          <div class="thumb">05</div>
          <div class="card-top">
            <h3 class="title">规划产品 03（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">对外只给“可理解但不可对标”的信息层：用途、边界、核对。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>

        <!-- 规划 06 -->
        <article class="card">
          <div class="thumb">06</div>
          <div class="card-top">
            <h3 class="title">规划产品 04（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">维持产品体系一致的语言：事实、节点、边界、追溯。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>

        <!-- 规划 07 -->
        <article class="card">
          <div class="thumb">07</div>
          <div class="card-top">
            <h3 class="title">规划产品 05（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">公开“交付将如何被核对”，不公开“如何做到”的工艺细节。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>

        <!-- 规划 08 -->
        <article class="card">
          <div class="thumb">08</div>
          <div class="card-top">
            <h3 class="title">规划产品 06（占位）</h3>
            <span class="badge plan">规划</span>
          </div>
          <p class="text">信息只到“你该知道的程度”，避免被竞争对手做参数对标。</p>
          <div class="card-actions">
            <a class="btn" href={contactHref}>咨询</a>
            <a class="btn ghost" href={contactHref}>合作提案</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
    .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

    /* HERO（来自首页模块的风格） */
    .hero { padding: 26px 0 18px; }
    .hero-grid { display: grid; grid-template-columns: minmax(480px, 1fr) minmax(520px, 1fr);
      gap: 24px; align-items: start; }
    @media (max-width: 980px) { .hero-grid { grid-template-columns: 1fr; } }

    .eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
    .h1 { font-size: clamp(28px, 3.1vw, 42px); line-height: 1.14; margin: 12px 0 10px; letter-spacing: -0.02em; }
    .nowrap { white-space: nowrap; overflow-x: auto; overflow-y: hidden; padding-bottom: 6px; scrollbar-width: thin; }
    .sub { font-size: 15px; opacity: .88; line-height: 1.7; max-width: 70ch; }
    .micro { margin-top: 10px; font-size: 13px; opacity: .72; line-height: 1.7; max-width: 70ch; }

    .spec { margin-top: 16px; border-radius: 18px; border: 1px solid rgba(220,235,240,.10); background: rgba(10,22,26,.12); overflow: hidden; }
    .spec-row { display: grid; grid-template-columns: 84px 1fr; gap: 14px; padding: 11px 14px; border-top: 1px solid rgba(220,235,240,.08); }
    .spec-row:first-child { border-top: none; }
    .k { font-size: 12px; opacity: .65; letter-spacing: .08em; text-transform: uppercase; }
    .v { font-size: 14px; opacity: .92; }

    .cta-row { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }

    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      padding: 10px 14px; border-radius: 999px;
      border: 1px solid rgba(220,235,240,0.14);
      color: rgba(220,235,240,0.88);
      text-decoration:none;
      background: rgba(10,22,26,0.10);
      transition: border-color .2s ease, background .2s ease;
      white-space: nowrap;
      cursor: pointer;
      font-size: 14px;
    }
    .btn:hover{ border-color: rgba(220,235,240,0.24); background: rgba(10,22,26,0.14); }
    .btn.primary { background: rgba(120,210,210,.16); border-color: rgba(120,210,210,.45); }
    .btn.ghost{ background: transparent; border-color: rgba(220,235,240,0.10); color: rgba(220,235,240,0.76); }

    .order-hint { margin-top: 10px; font-size: 13px; opacity: .72; }

    .hero-media { width: 100%; margin-top: 48px; }
    @media (max-width: 980px) { .hero-media { margin-top: 18px; } }

    /* Placeholder */
    .ph-fit{
      border-radius: 22px;
      border: 1px solid rgba(220,235,240,0.12);
      overflow: hidden;
      background: rgba(10,22,26,0.10);
      box-shadow: 0 18px 38px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.06);
      min-height: 320px;
    }
    .ph-inner{ height: 100%; padding: 14px; display:flex; flex-direction: column; justify-content: space-between; }
    .ph-top{ display:flex; justify-content: space-between; gap: 10px; align-items:center; }
    .tag{
      display:inline-flex; align-items:center; justify-content:center;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(220,235,240,0.12);
      color: rgba(220,235,240,0.82);
      background: rgba(10,22,26,0.06);
      font-size: 12px;
      width: fit-content;
    }
    .dim{ color: rgba(220,235,240,0.55); font-size: 12px; }
    .ph-title{ color: rgba(220,235,240,0.90); font-weight: 800; letter-spacing: 0.02em; }
    .ph-sub{ color: rgba(220,235,240,0.66); margin-top: 6px; }
    .ph-bottom{ display:flex; justify-content: space-between; gap: 10px; }
    .muted{ color: rgba(220,235,240,0.56); font-size: 12px; }
    .media-note{ margin-top: 10px; color: rgba(220,235,240,0.56); font-size: 12px; line-height: 1.6; }

    /* Catalog */
    .catalog{ padding: 18px 0 44px; }
    .catalog-head{ border-top: 1px solid rgba(220,235,240,0.08); padding-top: 18px; }
    .h2b{ margin: 0; font-size: 18px; letter-spacing: 0.02em; color: rgba(220,235,240,0.92); }
    .catalog-note{ margin-top: 8px; color: rgba(220,235,240,0.66); line-height: 1.7; max-width: 92ch; }

    .grid{
      display:grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .card{
      border-radius: 18px;
      border: 1px solid rgba(220,235,240,0.10);
      background: radial-gradient(120% 120% at 20% 0%,
        rgba(48, 92, 110, 0.22) 0%,
        rgba(14, 26, 30, 0.55) 45%,
        rgba(10, 16, 18, 0.34) 100%);
      box-shadow: 0 14px 32px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.06);
      padding: 14px;
      display:flex;
      flex-direction: column;
      min-height: 230px;
    }
    .thumb{
      height: 96px;
      border-radius: 14px;
      border: 1px solid rgba(220,235,240,0.10);
      background: linear-gradient(135deg, rgba(48,92,110,0.34), rgba(10,16,18,0.08));
      display:flex; align-items:center; justify-content:center;
      color: rgba(220,235,240,0.70);
      font-weight: 800;
      letter-spacing: 0.14em;
      margin-bottom: 12px;
    }
    .card-top{ display:flex; justify-content:space-between; gap: 10px; align-items:flex-start; }
    .title{ margin: 0; font-size: 14px; color: rgba(220,235,240,0.92); line-height: 1.4; }
    .badge{
      font-size: 12px;
      padding: 5px 9px;
      border-radius: 999px;
      border: 1px solid rgba(220,235,240,0.12);
      background: rgba(10,22,26,0.06);
      color: rgba(220,235,240,0.74);
      white-space: nowrap;
    }
    .badge.presale{ border-color: rgba(255,210,120,0.22); }
    .badge.plan{ border-color: rgba(220,235,240,0.12); opacity: .9; }
    .text{ margin: 10px 0 0; color: rgba(220,235,240,0.66); line-height: 1.65; font-size: 13px; }
    .card-actions{ display:flex; gap: 10px; margin-top: auto; flex-wrap: wrap; padding-top: 12px; }

    @media (max-width: 1100px){
      .grid{ grid-template-columns: repeat(2, minmax(0,1fr)); }
      .hero-grid{ grid-template-columns: 1fr; }
      .hero-media{ margin-top: 18px; }
    }
    @media (max-width: 680px){
      .grid{ grid-template-columns: 1fr; }
    }
  </style>
</Base>
