---
import Base from "@/layouts/Base.astro";
---

<Base lang="zh" title="ORDO · 商店">
  <section class="page-shell">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Shop</div>
        <h1 class="h1">商店</h1>
        <p class="lead">
          展示在售 / 预售与规划产品。下单采用邮件确认形式：你提交需求，我们以邮件回执确认版本、交付与条款。
        </p>
      </div>
    </div>
  </section>

  <!-- 推荐产品：移植自首页产品推荐模块 -->
<section class="home-section families" aria-label="我们卖什么">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">What We Make</div>
        <h2 class="h2">三类器具，覆盖三类「状态事实」</h2>
        <p class="lead">不是更多功能，而是更少误解、更少遗漏、更少争执。</p>
      </div>

      <div class="family-list" role="list">
        <div class="family" role="listitem">
          <div class="family-title">阅读与定位类器具</div>
          <div class="family-desc">把你读到的位置，变成可被确认的事实。</div>
          <a class="link" href="/zh/products#reading">探索该系列 →</a>
        </div>
        <div class="family" role="listitem">
          <div class="family-title">边界确认类器具</div>
          <div class="family-desc">把开始、结束与切换，从意志力变成环境事实。</div>
          <a class="link" href="/zh/products#boundary">探索该系列 →</a>
        </div>
        <div class="family" role="listitem">
          <div class="family-title">责任事实类器具</div>
          <div class="family-desc">让已履行、已交接、已关闭，被清楚地看见。</div>
          <a class="link" href="/zh/products#responsibility">探索该系列 →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-shell" id="all-products">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">其他产品</h2>
        <p class="muted">按网上商城经典布局呈现（8 个产品框位）。具体型号、图片与价格在后续逐步补齐。</p>
      </div>

      <div class="cards3">
        <a class="card" href="/zh/contact">
          <div class="card-title">产品 01</div>
          <p class="muted" style="margin-top:10px">用于展示在售 / 预售 / 规划产品。通过邮件确认下单。</p>
          <div class="btn-row" style="margin-top:14px">
            <span class="btn ghost">邮件咨询 →</span>
